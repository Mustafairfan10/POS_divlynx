# Postgres connection string (Neon / Vercel Postgres / Supabase / any Postgres).
# Leave empty locally to use the embedded database in .data/ (zero setup).
DATABASE_URL=

# Code staff enter once to connect a new device to this store.
STORE_ACCESS_CODE=change-me

# Long random string used to sign device tokens. Generate: openssl rand -base64 32
AUTH_SECRET=
