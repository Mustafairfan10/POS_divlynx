{
  // Tailwind CSS v4 uses @theme, @utility and @custom-variant, which VS Code's
  // built-in CSS validator doesn't know. Tell it to stop flagging them.
  "css.lint.unknownAtRules": "ignore",
  // With the Tailwind CSS IntelliSense extension installed, treat .css files as
  // Tailwind so these at-rules get proper highlighting and completions.
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
